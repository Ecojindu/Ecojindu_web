# ─────────────────────────────────────────────────────────────
#  Ecojindu Shuttle — Customer Website (.env.local)
#
#  Everything prefixed NEXT_PUBLIC_ is inlined into the browser
#  bundle — never put a secret behind that prefix.
# ─────────────────────────────────────────────────────────────

# ── Backend API ──────────────────────────────────────────────
# The core service. The browser calls this directly, so it must be
# reachable from the client and listed in the backend's CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Paystack ─────────────────────────────────────────────────
# Publishable key only. Safe in the browser by design.
# Leave blank while PAYSTACK_MOCK=true on the backend — checkout then
# redirects to the backend's local mock page instead of Paystack's popup.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Contact / deep links ─────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=2348154471570
NEXT_PUBLIC_CONTACT_EMAIL=hello@ecojindu.ng
NEXT_PUBLIC_CONTACT_PHONE=+234 815 447 1570
NEXT_PUBLIC_SOCIAL_HANDLE=@ecojindu.ng

# ── Site ─────────────────────────────────────────────────────
# Production Cloud Run URL — required for correct Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://ecojindu-web-480235407496.us-central1.run.app
NEXT_PUBLIC_SITE_NAME=Ecojindu Shuttle
